# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key. Server-only: bypasses RLS, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Absolute origin used for auth email links (and the Yahoo redirect in Phase 1).
# Vercel sets VERCEL_URL automatically; set this for local dev and for a
# stable production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 1 (not used yet) -------------------------------------------------
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
