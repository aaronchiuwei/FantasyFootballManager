# --- Supabase ---------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key. Server-only: bypasses RLS, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Absolute origin used for auth email links, the Yahoo redirect, and the sync
# pipeline's stage-to-stage calls — the app calls its own origin to hand one
# stage to the next, so this has to be an address this deployment can reach.
#
#   local dev   http://localhost:3000
#   deployed    your production domain
#
# NOT a deployment URL (project-hash-team.vercel.app). Vercel Authentication
# protects those by default, so the app cannot call itself and every stage
# after the first fails with a 401 from Vercel rather than from this app.
# Left unset, the app prefers VERCEL_PROJECT_PRODUCTION_URL over VERCEL_URL
# for the same reason.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Yahoo ------------------------------------------------------------------
# Register at https://developer.yahoo.com/apps/create/ with API permission
# "Fantasy Sports — Read". Yahoo requires an HTTPS callback: use your deployed
# URL, or a tunnel (ngrok/cloudflared) for local development.
YAHOO_CLIENT_ID=<yahoo-client-id>
YAHOO_CLIENT_SECRET=<yahoo-client-secret>

# Only needed when the callback origin differs from NEXT_PUBLIC_SITE_URL —
# e.g. developing behind a tunnel. Must match the app registration exactly.
# YAHOO_REDIRECT_URI=https://<your-tunnel>/api/yahoo/callback

# --- Secrets ----------------------------------------------------------------
# Encrypts Yahoo tokens at rest, and signs the sync pipeline's stage-to-stage
# requests. Generate with: openssl rand -base64 32
# Rotating this invalidates stored tokens; users simply reconnect Yahoo. It
# also invalidates any sync run mid-flight, which simply fails and can be
# retried.
TOKEN_ENCRYPTION_KEY=<32-bytes-base64>

# Authorizes Vercel Cron hits to /api/cron/refresh. Vercel sends this value as
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -base64 32
CRON_SECRET=<32-bytes-base64>

# Only needed if you deploy behind Vercel Deployment Protection and want the
# sync pipeline to reach itself without exposing the deployment publicly.
# Generate it under Project Settings -> Deployment Protection -> Protection
# Bypass for Automation; Vercel injects it as this variable.
# VERCEL_AUTOMATION_BYPASS_SECRET=
